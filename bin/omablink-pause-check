#!/bin/bash

# Prints one reason per line why an eye-rest break must not start right now.
# Empty output means it is fine to take over the screen. Called once per due
# break rather than polled, so a ~50ms pw-dump parse costs nothing.
#
# Usage: omablink-pause-check <fullscreen> <microphone> <video> [meeting-regex]
#        1 enables a check, 0 disables it; an empty regex disables the
#        meeting-window check.

set -uo pipefail

check_fullscreen=${1:-1}
check_microphone=${2:-1}
check_video=${3:-1}
meeting_pattern=${4:-}

if [[ $check_fullscreen == 1 ]]; then
  # Any nonzero fullscreen mode counts: games, a maximised video, a
  # presentation. Hyprland reports it per focused window.
  hyprctl activewindow -j 2>/dev/null | /usr/bin/python3 -c '
import json, sys
try:
    window = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if window and window.get("fullscreen"):
    print("fullscreen")
' 2>/dev/null
fi

if [[ $check_microphone == 1 ]]; then
  # An app holding a capture stream means a call. Only catches a call whose
  # microphone is live: muting in Meet drops the stream, which is what the
  # meeting-window check below is for.
  if [[ -n $(pactl list short source-outputs 2>/dev/null) ]]; then
    echo microphone
  fi
fi

if [[ $check_video == 1 ]]; then
  # A PipeWire video capture node is either the camera or a screen share
  # through xdg-desktop-portal — both mean "do not cover the screen".
  pw-dump 2>/dev/null | /usr/bin/python3 -c '
import json, sys
try:
    nodes = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for node in nodes:
    props = (node.get("info") or {}).get("props") or {}
    if props.get("media.class") == "Stream/Input/Video":
        print("video")
        break
' 2>/dev/null
fi

if [[ -n $meeting_pattern ]]; then
  # A listen-only call holds neither microphone nor camera, so the last
  # signal is the window itself. Matches every window, not just the focused
  # one: the call usually sits behind whatever is being discussed. A tab that
  # is not the active one of its window is invisible here — Wayland only ever
  # exposes the active tab's title.
  hyprctl clients -j 2>/dev/null | /usr/bin/python3 -c '
import json, re, sys
try:
    pattern = re.compile(sys.argv[1], re.IGNORECASE)
except re.error:
    sys.exit(0)
try:
    clients = json.load(sys.stdin)
except Exception:
    sys.exit(0)
for client in clients:
    if pattern.search(client.get("title") or "") or pattern.search(client.get("class") or ""):
        print("meeting")
        break
' "$meeting_pattern" 2>/dev/null
fi

exit 0
